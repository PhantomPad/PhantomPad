<Window x:Class="DS4WinWPF.DS4Forms.GameProfiles.QuickTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PhantomPad"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:Loc PP_TuneTitle}" Width="880" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource WindowStyle}">
    <!-- PhantomPad: ajustes rapidos de zonas muertas y curvas para el perfil de un juego -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhantomPad;component/DS4Forms/Themes/PhantomPadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fila: etiqueta, deslizador y valor en % -->
            <Style x:Key="TuneLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,8,0,2" />
            </Style>
            <Style x:Key="TuneValue" TargetType="{x:Type TextBlock}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Width" Value="46" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PresetBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Pie: guardar / cancelar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBarColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{lex:Loc Cancel}" Padding="18,6" Margin="0,0,10,0" Click="CancelBtn_Click" />
                    <Button Style="{StaticResource OutlineAccentButtonStyle}" Height="32" Padding="22,0" Click="SaveBtn_Click">
                        <TextBlock Text="{lex:Loc PP_TuneSave}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{lex:Loc PP_TuneHint}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,12">
                <!-- Cabecera: juego y perfil -->
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="ownProfileBtn" DockPanel.Dock="Right" Content="{lex:Loc PP_TuneOwnProfile}" Padding="14,6" VerticalAlignment="Center"
                            Click="OwnProfileBtn_Click" ToolTip="{lex:Loc PP_TuneOwnProfileTip}" />
                    <StackPanel>
                        <TextBlock Text="{Binding GameName}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource MutedForegroundColor}">
                            <Run Text="{lex:Loc PP_TuneEditingProfile}" /><Run Text=" " /><Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Accent2Color}" />
                        </TextBlock>
                        <TextBlock x:Name="sharedWarning" Text="{lex:Loc PP_TuneSharedWarning}" Foreground="{DynamicResource AccentLightColor}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>

                <!-- Preajustes -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc PP_TunePresets, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Style="{StaticResource PresetBtn}" Content="{lex:Loc PP_TunePresetPrecision}" Tag="precision" Click="PresetBtn_Click" ToolTip="{lex:Loc PP_TunePresetPrecisionTip}" />
                            <Button Style="{StaticResource PresetBtn}" Content="{lex:Loc PP_TunePresetFast}" Tag="fast" Click="PresetBtn_Click" ToolTip="{lex:Loc PP_TunePresetFastTip}" />
                            <Button Style="{StaticResource PresetBtn}" Content="{lex:Loc PP_TunePresetSmooth}" Tag="smooth" Click="PresetBtn_Click" ToolTip="{lex:Loc PP_TunePresetSmoothTip}" />
                            <Button Style="{StaticResource PresetBtn}" Content="{lex:Loc PP_TunePresetDefault}" Tag="default" Click="PresetBtn_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Sticks -->
                <UniformGrid Columns="2">
                    <!-- Stick izquierdo -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,7,14" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc LeftStick, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="SemiBold" />
                            <DockPanel Margin="0,8,0,0">
                                <Border DockPanel.Dock="Right" Width="154" Height="154" Margin="14,4,0,0" CornerRadius="6" Background="{DynamicResource SidebarColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ToolTip="{lex:Loc PP_TuneGraphTip}">
                                    <Canvas Width="150" Height="150" ClipToBounds="True">
                                        <Line X1="0" Y1="150" X2="150" Y2="0" Stroke="{DynamicResource BorderColor}" StrokeDashArray="3 3" />
                                        <Polyline Points="{Binding LSCurvePoints}" Stroke="{DynamicResource Accent2Color}" StrokeThickness="2.5" />
                                    </Canvas>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc DeadZone}" Style="{StaticResource TuneLabel}" />
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding LSDeadZone, StringFormat={}{0:0} %}" />
                                        <Slider Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding LSDeadZone}" VerticalAlignment="Center" /></DockPanel>
                                    <TextBlock Text="{lex:Loc AntiDeadZone}" Style="{StaticResource TuneLabel}" />
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding LSAntiDeadZone, StringFormat={}{0:0} %}" />
                                        <Slider Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding LSAntiDeadZone}" VerticalAlignment="Center" /></DockPanel>
                                    <TextBlock Text="{lex:Loc MaxZone}" Style="{StaticResource TuneLabel}" />
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding LSMaxZone, StringFormat={}{0:0} %}" />
                                        <Slider Minimum="50" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding LSMaxZone}" VerticalAlignment="Center" /></DockPanel>
                                    <TextBlock Text="{lex:Loc OutputCurve}" Style="{StaticResource TuneLabel}" />
                                    <ComboBox ItemsSource="{Binding CurveNames}" SelectedIndex="{Binding LSCurve}" Height="28" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stick derecho -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="7,0,0,14" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc RightStick, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="SemiBold" />
                            <DockPanel Margin="0,8,0,0">
                                <Border DockPanel.Dock="Right" Width="154" Height="154" Margin="14,4,0,0" CornerRadius="6" Background="{DynamicResource SidebarColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ToolTip="{lex:Loc PP_TuneGraphTip}">
                                    <Canvas Width="150" Height="150" ClipToBounds="True">
                                        <Line X1="0" Y1="150" X2="150" Y2="0" Stroke="{DynamicResource BorderColor}" StrokeDashArray="3 3" />
                                        <Polyline Points="{Binding RSCurvePoints}" Stroke="{DynamicResource Accent2Color}" StrokeThickness="2.5" />
                                    </Canvas>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc DeadZone}" Style="{StaticResource TuneLabel}" />
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding RSDeadZone, StringFormat={}{0:0} %}" />
                                        <Slider Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RSDeadZone}" VerticalAlignment="Center" /></DockPanel>
                                    <TextBlock Text="{lex:Loc AntiDeadZone}" Style="{StaticResource TuneLabel}" />
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding RSAntiDeadZone, StringFormat={}{0:0} %}" />
                                        <Slider Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RSAntiDeadZone}" VerticalAlignment="Center" /></DockPanel>
                                    <TextBlock Text="{lex:Loc MaxZone}" Style="{StaticResource TuneLabel}" />
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding RSMaxZone, StringFormat={}{0:0} %}" />
                                        <Slider Minimum="50" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RSMaxZone}" VerticalAlignment="Center" /></DockPanel>
                                    <TextBlock Text="{lex:Loc OutputCurve}" Style="{StaticResource TuneLabel}" />
                                    <ComboBox ItemsSource="{Binding CurveNames}" SelectedIndex="{Binding RSCurve}" Height="28" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Gatillos -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc PPX_Triggers, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="SemiBold" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource TuneLabel}"><Run Text="L2 · " /><Run Text="{lex:Loc DeadZone}" /></TextBlock>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding L2DeadZone, StringFormat={}{0:0} %}" />
                                    <Slider Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding L2DeadZone}" VerticalAlignment="Center" /></DockPanel>
                                <TextBlock Style="{StaticResource TuneLabel}"><Run Text="L2 · " /><Run Text="{lex:Loc OutputCurve}" /></TextBlock>
                                <ComboBox ItemsSource="{Binding CurveNames}" SelectedIndex="{Binding L2Curve}" Height="28" />
                            </StackPanel>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Style="{StaticResource TuneLabel}"><Run Text="R2 · " /><Run Text="{lex:Loc DeadZone}" /></TextBlock>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource TuneValue}" Text="{Binding R2DeadZone, StringFormat={}{0:0} %}" />
                                    <Slider Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding R2DeadZone}" VerticalAlignment="Center" /></DockPanel>
                                <TextBlock Style="{StaticResource TuneLabel}"><Run Text="R2 · " /><Run Text="{lex:Loc OutputCurve}" /></TextBlock>
                                <ComboBox ItemsSource="{Binding CurveNames}" SelectedIndex="{Binding R2Curve}" Height="28" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
