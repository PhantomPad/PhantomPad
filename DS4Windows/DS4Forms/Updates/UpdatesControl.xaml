<UserControl x:Class="DS4WinWPF.DS4Forms.Updates.UpdatesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PhantomPad"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <!-- PhantomPad: Configuraciones > Actualizaciones -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhantomPad;component/DS4Forms/Themes/PhantomPadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="16,18,22,8" MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Text="{lex:Loc PP_UpdTitle}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{lex:Loc PP_UpdIntro}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4,0,16" />

        <!-- Version actual y estado -->
        <Border Style="{StaticResource SectionCardStyle}" Padding="20,16" Margin="0,0,0,12">
            <DockPanel>
                <Button x:Name="checkBtn" DockPanel.Dock="Right" Style="{StaticResource OutlineAccentButtonStyle}" Height="34" Padding="18,0"
                        VerticalAlignment="Center" Click="CheckBtn_Click">
                    <TextBlock Text="{lex:Loc PP_UpdCheckNow}" />
                </Button>
                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource TileColor}" Margin="0,0,16,0">
                    <TextBlock x:Name="stateIcon" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentLightColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="stateTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="stateText" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundColor}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nueva version -->
        <Border x:Name="releaseCard" Style="{StaticResource SectionCardStyle}" Padding="0" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <Border CornerRadius="10,10,0,0" ClipToBounds="True">
                    <Image x:Name="releaseImage" MaxHeight="260" Stretch="Uniform" Visibility="Collapsed" />
                </Border>
                <StackPanel Margin="20,16">
                    <DockPanel>
                        <TextBlock x:Name="releaseDate" DockPanel.Dock="Right" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center" />
                        <TextBlock x:Name="releaseTitle" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{lex:Loc PP_UpdWhatsNew, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedForegroundColor}" Margin="0,14,0,6" />
                    <TextBlock x:Name="releaseNotes" TextWrapping="Wrap" />

                    <ProgressBar x:Name="downloadProgress" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="downloadBtn" Style="{StaticResource OutlineAccentButtonStyle}" Height="34" Padding="18,0" Margin="0,0,10,0" Click="DownloadBtn_Click">
                            <TextBlock Text="{lex:Loc PP_UpdDownload}" />
                        </Button>
                        <Button x:Name="restartBtn" Height="34" Padding="18,0" Margin="0,0,10,0" Click="RestartBtn_Click" Visibility="Collapsed"
                                Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="{lex:Loc PP_UpdRestart}" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="pageBtn" Style="{StaticResource LinkButtonStyle}" Click="PageBtn_Click" VerticalAlignment="Center">
                            <TextBlock Text="{lex:Loc PP_UpdOpenPage}" Foreground="{DynamicResource AccentLightColor}" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{lex:Loc PP_UpdNote}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}" Margin="4,0,4,8" />
    </StackPanel>
</UserControl>
