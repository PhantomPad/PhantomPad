<Window x:Class="DS4WinWPF.DS4Forms.Uninstall.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PhantomPad"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:Loc PP_UninTitle}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource WindowStyle}">
    <!-- PhantomPad: desinstalar todo (PhantomPad, ajustes, ViGEmBus y HidHide) -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhantomPad;component/DS4Forms/Themes/PhantomPadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="{lex:Loc PP_UninTitle}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{lex:Loc PP_UninIntro}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,6,0,16" />

        <Border Style="{StaticResource SectionCardStyle}" Padding="20,14" Margin="0,0,0,12">
            <StackPanel x:Name="stepList" />
        </Border>

        <CheckBox x:Name="settingsCk" Content="{lex:Loc PP_UninSettings}" Style="{StaticResource ToggleSwitchStyle}" Padding="0,6" IsChecked="True" />
        <TextBlock Text="{lex:Loc PP_UninSettingsText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,14" />

        <TextBlock x:Name="noteText" Text="{lex:Loc PP_UninNote}" TextWrapping="Wrap" FontSize="12" Foreground="#FFF87171" Margin="2,0,2,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="cancelBtn" Content="{lex:Loc PP_UninCancel}" Padding="18,7" Margin="0,0,10,0" Click="CancelBtn_Click" />
            <Button x:Name="uninstallBtn" Padding="22,7" Click="UninstallBtn_Click" Background="#FFB91C1C" Foreground="White" BorderBrush="#FFB91C1C">
                <TextBlock x:Name="uninstallBtnText" Text="{lex:Loc PP_UninButton}" FontWeight="SemiBold" />
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
