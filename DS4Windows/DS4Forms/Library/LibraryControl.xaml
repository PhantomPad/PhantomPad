<UserControl x:Class="DS4WinWPF.DS4Forms.Library.LibraryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PhantomPad"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100">
    <!-- PhantomPad: Escritorio → biblioteca de juegos (estilo Playnite) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhantomPad;component/DS4Forms/Themes/PhantomPadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Tarjeta de un juego: portada 2:3 y nombre -->
            <DataTemplate x:Key="GameCardTemplate">
                <StackPanel Width="150" Margin="8">
                    <Grid Width="150" Height="225">
                        <!-- Sin portada: degradado, icono del juego y nombre -->
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF2A2450" Offset="0" />
                                    <GradientStop Color="#FF151228" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" Margin="12">
                                <Image Source="{Binding Icon}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"
                                           Foreground="White" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Portada -->
                        <Border CornerRadius="8" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <!-- No instalado -->
                        <Border CornerRadius="8" Background="#99000000" Visibility="{Binding NotInstalled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NotInstalledText}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                        </Border>
                        <!-- Seleccion -->
                        <Border x:Name="selBorder" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SourceText}" Margin="2,1,2,0" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="selBorder" Property="BorderBrush" Value="{DynamicResource Accent2Color}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Elemento de la lista sin el resaltado azul de Windows -->
            <Style x:Key="CardItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="10">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryColor}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filtro (Todos / Steam / Epic ...) -->
            <Style x:Key="FilterChipStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="chip" CornerRadius="14" Padding="14,5" Background="{DynamicResource SecondaryColor}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource Accent2Color}" />
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource Accent2Color}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarColor}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>

        <!-- ===== Lista de juegos ===== -->
        <DockPanel Grid.Column="0" Margin="18,14,8,0">
            <!-- Barra: buscar, anadir, actualizar -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineAccentButtonStyle}" Height="34" Padding="16,0" Margin="8,0,0,0" Click="AddBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{lex:Loc PP_LibAdd}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="refreshBtn" DockPanel.Dock="Right" Height="34" Padding="14,0" Margin="8,0,0,0" Click="RefreshBtn_Click" ToolTip="{lex:Loc PP_LibRefreshTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{lex:Loc PP_LibRefresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid>
                    <TextBox x:Name="searchBox" Height="34" VerticalContentAlignment="Center" Padding="32,0,8,0" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"
                               Foreground="{DynamicResource MutedForegroundColor}" />
                    <TextBlock x:Name="searchHint" Text="{lex:Loc PP_LibSearch}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="34,0,0,0"
                               Foreground="{DynamicResource MutedForegroundColor}" />
                </Grid>
            </DockPanel>

            <!-- Filtros -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center" Click="SourcesBtn_Click"
                        ToolTip="{lex:Loc PP_SrcTitle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{lex:Loc PP_SrcButton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <CheckBox x:Name="autoMetaToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" Padding="10,4"
                          Content="{lex:Loc PP_LibAutoMeta}" ToolTip="{lex:Loc PP_LibAutoMetaTip}" VerticalAlignment="Center"
                          Checked="AutoMetaToggle_Changed" Unchecked="AutoMetaToggle_Changed" />
                <WrapPanel x:Name="filterPanel" />
            </DockPanel>
            <TextBlock x:Name="metaStatus" DockPanel.Dock="Top" Margin="2,0,0,6" FontSize="12" Foreground="{DynamicResource AccentLightColor}" Visibility="Collapsed" />

            <!-- Cuadricula -->
            <Grid>
                <ListBox x:Name="gameList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource GameCardTemplate}"
                         ItemContainerStyle="{StaticResource CardItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="GameList_SelectionChanged" MouseDoubleClick="GameList_MouseDoubleClick" KeyDown="GameList_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="cardMenu" Opened="CardMenu_Opened" />
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="emptyText" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                           MaxWidth="420" Foreground="{DynamicResource MutedForegroundColor}" Visibility="Collapsed" />
            </Grid>
        </DockPanel>

        <!-- ===== Ficha del juego elegido ===== -->
        <Border Grid.Column="1" Background="{DynamicResource HeaderBarColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <Grid>
                <ScrollViewer x:Name="detailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Fondo + logo -->
                        <Grid Height="190">
                            <Border x:Name="bgImageHost" ClipToBounds="True">
                                <Image x:Name="bgImage" Stretch="UniformToFill" VerticalAlignment="Center" />
                            </Border>
                            <!-- Fundido hacia el color del panel (sirve para tema claro y oscuro) -->
                            <Rectangle Fill="{DynamicResource HeaderBarColor}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.35" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Image x:Name="logoImage" MaxHeight="90" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,20,10"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>

                        <StackPanel Margin="20,6,20,20">
                            <TextBlock x:Name="detailName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="detailInfo" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap" />

                            <Button x:Name="playBtn" Height="46" Margin="0,16,0,0" Click="PlayBtn_Click" Cursor="Hand"
                                    Background="{DynamicResource Accent2Color}" Foreground="{DynamicResource SidebarColor}" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="playText" Text="{lex:Loc PP_LibPlay}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="playHint" Text="{lex:Loc PP_LibPlayHint}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedForegroundColor}" />

                            <WrapPanel Margin="0,14,0,0">
                                <Button Padding="12,6" Margin="0,0,8,8" Click="EditBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{lex:Loc PP_LibEdit}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,6" Margin="0,0,8,8" Click="ControllerBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{lex:Loc PP_LibControllerSettings}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="folderBtn" Padding="12,6" Margin="0,0,8,8" Click="FolderBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{lex:Loc PP_LibOpenFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,6" Margin="0,0,8,8" Click="RemoveBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{lex:Loc PP_LibRemove}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <TextBlock x:Name="detailDescription" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="noSelectionText" Text="{lex:Loc PP_LibPickGame}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="30" Foreground="{DynamicResource MutedForegroundColor}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
