                        <TextBlock Text="{lex:Loc PP_SectionCommands}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{lex:Loc PP_CommandsIntro}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4,0,16" />

                        <ItemsControl x:Name="commandsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12" Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icono -->
                                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource TileColor}" Margin="0,0,16,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Icon, Mode=OneTime}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                           Foreground="{DynamicResource AccentLightColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Que hace -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="{Binding Name, Mode=OneTime}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description, Mode=OneTime}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource MutedForegroundColor}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource AccentLightColor}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Where, Mode=OneTime}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentLightColor}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Botones -->
                                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0" Padding="20,0,0,0" MinWidth="230">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ButtonsLabel, Mode=OneTime}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,8" />
                                                    <ComboBox ItemsSource="{Binding Options, Mode=OneTime}" SelectedIndex="{Binding SelectedIndex}" MinWidth="200"
                                                              Visibility="{Binding ConfigVisibility, Mode=OneTime}" />
                                                    <ItemsControl ItemsSource="{Binding Buttons, Mode=OneTime}" Visibility="{Binding ButtonsVisibility, Mode=OneTime}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel MaxWidth="230" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Boton dibujado como una tecla del mando -->
                                                                <Border Background="{DynamicResource TileColor}" BorderBrush="{DynamicResource Accent2Color}" BorderThickness="1"
                                                                        CornerRadius="7" Padding="10,5" Margin="0,0,6,6">
                                                                    <TextBlock Text="{Binding Mode=OneTime}" FontWeight="SemiBold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= REGISTRO ================= -->
            <TabItem Header="{lex:Loc Log}" Tag="&#xE8FD;">
                <DockPanel Margin="22,14,22,8">
                    <DockPanel Height="30" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="exportLogBtn" Content="{lex:Loc Export}" HorizontalAlignment="Left" Padding="20,1" Click="ExportLogBtn_Click" />
                        <Button x:Name="clearLogBtn" Content="{lex:Loc Clear}" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="20,1" Click="ClearLogBtn_Click" />
                    </DockPanel>
                    <ListView x:Name="logListView" DockPanel.Dock="Top" ItemsSource="{Binding LogItems}" MouseDoubleClick="LogListView_MouseDoubleClick" Margin="0"
                              Background="{DynamicResource SurfaceColor}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="{lex:Loc PP_LogTime}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Datetime, StringFormat=\{0:G\}}" Foreground="{DynamicResource MutedForegroundColor}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{lex:Loc PP_LogMessage}" Width="800">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Message}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- ===== Barra superior (encima del contenido, a la derecha de la barra de iconos) ===== -->
        <Border Height="60" VerticalAlignment="Top" Margin="86,0,0,0" Background="{DynamicResource HeaderBarColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel Margin="22,0,18,0">
                <Button x:Name="StartStopBtn" DockPanel.Dock="Right" Content="{lex:Loc StartText}" Click="StartStopBtn_Click"
                        Style="{StaticResource OutlineAccentButtonStyle}" MinWidth="120" Height="34" Padding="18,0" VerticalAlignment="Center" />
                <!-- PhantomPad: aviso de actualizacion ("Nueva version" / "Reiniciar app") -->
                <Button x:Name="updateHeaderBtn" DockPanel.Dock="Right" Click="UpdateHeaderBtn_Click" Visibility="Collapsed" Height="34" Padding="16,0"
                        Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="updateHeaderText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedItem.Header, ElementName=mainTabCon, Converter={StaticResource UpperCaseConverter}}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Border Style="{StaticResource ChipStyle}" ToolTip="{lex:Loc Controllers}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"
                                       Foreground="{DynamicResource Accent2Color}" />
                            <TextBlock Text="{Binding Items.Count, ElementName=controllerLV}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Barra de estado (abajo) ===== -->
        <Border Height="36" VerticalAlignment="Bottom" Margin="86,0,0,0" Background="{DynamicResource HeaderBarColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0,12,0">
                <Button x:Name="aboutBtn" DockPanel.Dock="Right" BorderThickness="0" Background="{x:Null}" BorderBrush="{x:Null}"
                        Style="{StaticResource NoBGHoverBtn}" Click="AboutBtn_Click" VerticalAlignment="Center">
                    <TextBlock Text="{lex:Loc HotkeysAbout}" Foreground="{DynamicResource AccentLightColor}" Cursor="Hand" x:Uid="hotkeysText" />
                </Button>
                <Label x:Name="lastMsgLb" Content="{Binding Message}" ToolTip="{Binding Message}" Foreground="{Binding Color}" VerticalAlignment="Center" Padding="0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
