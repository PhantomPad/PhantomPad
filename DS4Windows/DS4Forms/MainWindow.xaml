                                             Margin="16,0,16,8" Height="26" VerticalContentAlignment="Center" />
                                    <DockPanel Margin="16,7">
                                        <Label Content="{lex:Loc CustomExeName}" Padding="0" VerticalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,5" />
