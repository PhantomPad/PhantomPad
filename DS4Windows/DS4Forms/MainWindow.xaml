<Window x:Name="mainDS4Window" x:Class="DS4WinWPF.DS4Forms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="PhantomPad"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:localConverters="clr-namespace:DS4WinWPF.DS4Forms.Converters"
        xmlns:gp="clr-namespace:DS4WinWPF.DS4Forms.GameProfiles"
        xmlns:cal="clr-namespace:DS4WinWPF.DS4Forms.Calibration"
        xmlns:bat="clr-namespace:DS4WinWPF.DS4Forms.BatteryPage"
        xmlns:upd="clr-namespace:DS4WinWPF.DS4Forms.Updates"
        xmlns:defs="clr-namespace:DS4WinWPF.DS4Forms.ControllerDefs"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xml:lang="en-US"
        mc:Ignorable="d"
        Title="PhantomPad" Height="620" Width="1040" Closing="MainDS4Window_Closing" Closed="MainDS4Window_Closed" StateChanged="MainDS4Window_StateChanged" SizeChanged="MainDS4Window_SizeChanged" LocationChanged="MainDS4Window_LocationChanged" MinWidth="780" MinHeight="420"
        Style="{DynamicResource WindowStyle}">
    <!--
        PhantomPad: diseno nuevo.
        - Barra de iconos a la izquierda (estilo RailTabControlStyle sobre mainTabCon).
        - Barra superior y barra de estado superpuestas al contenido (mismo Grid).
        - Mandos como tarjetas grandes; Ajustes en secciones con interruptores.
        Todos los nombres (x:Name), enlaces y eventos originales se conservan.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhantomPad;component/DS4Forms/Themes/PhantomPadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:ImageLocationPaths x:Key="ImgLocPaths" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="notifyIcon" IconSource="{Binding IconSource,Mode=OneWay}" ToolTipText="{Binding TooltipText,Mode=OneWay}" MenuActivation="RightClick" TrayRightMouseUp="NotifyIcon_TrayRightMouseUp" TrayMiddleMouseDown="NotifyIcon_TrayMiddleMouseDown" TrayMouseDoubleClick="NotifyIcon_TrayMouseDoubleClick" />

        <TabControl x:Name="mainTabCon" SelectionChanged="MainTabCon_SelectionChanged" Style="{StaticResource RailTabControlStyle}">

            <!-- ================= MANDOS ================= -->
            <TabItem Header="{lex:Loc Controllers}" Tag="&#xE7FC;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <Grid Margin="22,18,22,8">
                    <StackPanel x:Name="noContPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Visibility, ElementName=noContLb}">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="56" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TileColor}" Margin="0,0,0,12" />
                        <Label x:Name="noContLb" Visibility="Hidden" Content="{lex:Loc NoControllersConnected}" HorizontalContentAlignment="Center" FontSize="15" />
                        <TextBlock Text="{lex:Loc PP_ConnectHint}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>

                    <ListView x:Name="controllerLV" ItemsSource="{Binding ControllerCol}" SelectionMode="Single" SelectedIndex="{Binding CurrentIndex, Mode=OneWayToSource}" Margin="0"
                              Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ControllerHeroItemStyle}">
                        <ListView.Template>
                            <ControlTemplate TargetType="{x:Type ListView}">
                                <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListView.Template>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Dibujo del mando -->
                                    <Border Width="132" Height="92" CornerRadius="12" Background="{DynamicResource TileColor}" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="52" Foreground="{DynamicResource AccentLightColor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border CornerRadius="6" Background="{DynamicResource SidebarColor}" Padding="7,2" Margin="6"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent2Color}">
                                                    <Run Text="#" /><Run Text="{Binding DisplayDevIndex, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Nombre, conexion y bateria -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="idColumnTxtB" Text="{Binding DeviceName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                                   ToolTip="{Binding TooltipIDText, Mode=OneWay}" ToolTipOpening="IdColumnTxtB_ToolTipOpening" Tag="{Binding DevIndex, Mode=OneTime}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,12">
                                            <Image x:Name="contStatusImg" Source="{Binding StatusSource}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   ToolTip="{lex:Loc PP_RightClickDisconnect}" MouseRightButtonUp="ContStatusImg_MouseRightButtonUp" Tag="{Binding DevIndex}" />
                                            <TextBlock Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center">
                                                <Run Text="{Binding ConnectionText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding MacText, Mode=OneWay}" />
                                            </TextBlock>
                                            <Image Source="{Binding ExclusiveSource}" Stretch="Uniform" Width="14" Height="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="{Binding IsExclusiveText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE83F;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                            <ProgressBar Style="{StaticResource BatteryBarStyle}" Width="120" Value="{Binding BatteryLevel, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BatteryState, Mode=OneWay}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Perfil, edicion y color de la luz -->
                                    <StackPanel Grid.Column="2" Width="250" VerticalAlignment="Center">
                                        <TextBlock Text="{lex:Loc SelectedProfile, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5"
                                                   Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox x:Name="selectProfCombo" ItemsSource="{Binding ProfileListCol}" SelectedIndex="{Binding SelectedIndex}" Height="28" Margin="0,0,0,10"
                                                  Tag="{Binding DevIndex, Mode=OneTime}" Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  SelectionChanged="SelectProfCombo_SelectionChanged" KeyDown="SelectProfCombo_KeyDown">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name,Mode=OneWay,FallbackValue=''}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button x:Name="LightColorBtn" DockPanel.Dock="Right" Width="44" Height="28" Margin="8,0,0,0" Background="{Binding LightColor, Mode=OneWay}"
                                                    BorderBrush="{DynamicResource BorderColor}" Tag="{Binding DevIndex, Mode=OneTime}" Click="LightColorBtn_Click"
                                                    ToolTip="{lex:Loc PP_LightColor}" />
                                            <xctk:SplitButton x:Name="ProfEditSBtn" Content="{lex:Loc Edit}" Height="28" Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Tag="{Binding DevIndex, Mode=OneTime}" Click="ProfEditSBtn_Click">
                                                <xctk:SplitButton.DropDownContent>
                                                    <Button x:Name="newProfBtn" Content="{lex:Loc NewProfile}" MinWidth="120" Tag="{Binding DevIndex, Mode=OneTime}" Click="NewProfBtn_Click" />
                                                </xctk:SplitButton.DropDownContent>
                                            </xctk:SplitButton>
                                        </DockPanel>
                                        <CheckBox Content="{lex:Loc LinkProfileId}" IsChecked="{Binding LinkedProfile}" IsEnabled="{Binding PrimaryDevice}" />
                                    </StackPanel>
                                </Grid>

                                <!-- PhantomPad: seccion LUZ DEL MANDO -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Titulo + interruptores -->
                                        <StackPanel Width="250" Margin="0,0,28,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Accent2Color}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{lex:Loc PP_LightSection, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <CheckBox Content="{lex:Loc PP_LightOn}" Style="{StaticResource ToggleSwitchStyle}" Padding="0,6" IsChecked="{Binding LightEnabled}" />
                                            <CheckBox Content="{lex:Loc PP_LightCustomColor}" Style="{StaticResource ToggleSwitchStyle}" Padding="0,6"
                                                      IsChecked="{Binding UseCustomLightColor}" IsEnabled="{Binding LightEnabled}"
                                                      ToolTip="{lex:Loc PP_LightCustomColorTip}" />
                                        </StackPanel>

                                        <!-- Colores rapidos -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" IsEnabled="{Binding LightEnabled}">
                                            <TextBlock Text="{lex:Loc PP_LightQuickColors, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,8" />
                                            <WrapPanel>
                                                <WrapPanel.Resources>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Setter Property="Width" Value="26" />
                                                        <Setter Property="Height" Value="26" />
                                                        <Setter Property="Margin" Value="0,0,6,6" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type Button}">
                                                                    <Border x:Name="sw" CornerRadius="7" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="Transparent" />
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="sw" Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter TargetName="sw" Property="Opacity" Value="0.35" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <EventSetter Event="Click" Handler="QuickLightColor_Click" />
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <Button Background="#FF7C3AED" ToolTip="{lex:Loc PP_ColorViolet}" />
                                                <Button Background="#FF22D3EE" ToolTip="{lex:Loc PP_ColorCyan}" />
                                                <Button Background="#FF2563EB" ToolTip="{lex:Loc PP_ColorBlue}" />
                                                <Button Background="#FF22C55E" ToolTip="{lex:Loc PP_ColorGreen}" />
                                                <Button Background="#FFFACC15" ToolTip="{lex:Loc PP_ColorYellow}" />
                                                <Button Background="#FFF97316" ToolTip="{lex:Loc PP_ColorOrange}" />
                                                <Button Background="#FFEF4444" ToolTip="{lex:Loc PP_ColorRed}" />
                                                <Button Background="#FFEC4899" ToolTip="{lex:Loc PP_ColorPink}" />
                                                <Button Background="#FFFFFFFF" ToolTip="{lex:Loc PP_ColorWhite}" />
                                            </WrapPanel>

                                            <!-- Brillo + mas colores -->
                                            <DockPanel Margin="0,4,0,6">
                                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold">
                                                    <Run Text="{Binding LightBrightness, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %" />
                                                </TextBlock>
                                                <TextBlock Text="{lex:Loc PP_LightBrightness, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{lex:Loc PP_LightMoreColors}" Click="MoreLightColors_Click" Padding="14,5" Margin="16,0,0,0" />
                                                <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                                                        Value="{Binding LightBrightness}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- PhantomPad: seccion AJUSTES DEL MANDO (gyro aim global) -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Width="250" Margin="0,0,28,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Accent2Color}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{lex:Loc PP_CtrlSettingsSection, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <CheckBox Content="{lex:Loc PP_GyroAimOn}" Style="{StaticResource ToggleSwitchStyle}" Padding="0,6"
                                                      IsChecked="{Binding GyroEnabled}" ToolTip="{lex:Loc PP_GyroAimTip}" />
                                            <CheckBox Content="{lex:Loc PP_GyroPauseRacing}" Style="{StaticResource ToggleSwitchStyle}" Padding="0,6"
                                                      IsChecked="{Binding GyroPauseInRacing}" IsEnabled="{Binding GyroEnabled}"
                                                      ToolTip="{lex:Loc PP_GyroPauseRacingTip}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" IsEnabled="{Binding GyroEnabled}">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold">
                                                    <Run Text="{Binding GyroSensitivity, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %" />
                                                </TextBlock>
                                                <TextBlock Text="{lex:Loc PP_GyroSensitivity, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Slider Minimum="25" Maximum="300" SmallChange="5" LargeChange="25" IsSnapToTickEnabled="True" TickFrequency="5"
                                                    Value="{Binding GyroSensitivity}" />
                                            <TextBlock Text="{lex:Loc PP_GyroHint}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- PhantomPad: seccion CONEXION Y SALIDA (emulacion, apagado, frecuencia, latencia) -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Width="250" Margin="0,0,28,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Accent2Color}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{lex:Loc PP_ConnSection, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Mando no original -->
                                            <CheckBox Content="{lex:Loc PP_CompatMode}" Style="{StaticResource ToggleSwitchStyle}" Padding="0,6"
                                                      IsChecked="{Binding CompatMode}" ToolTip="{lex:Loc PP_CompatModeTip}"
                                                      Visibility="{Binding HasCompatMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <!-- Frecuencia de lectura -->
                                            <TextBlock Text="{lex:Loc PP_PollRate, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding PollOptions, Mode=OneTime}" SelectedIndex="{Binding PollChoiceIndex}" IsEnabled="{Binding CanSetPollRate, Mode=OneWay}"
                                                      HorizontalAlignment="Left" MinWidth="220" />
                                            <TextBlock Text="{Binding PollRateText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,12" />

                                            <!-- Latencia de lectura -->
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <TextBlock Text="{lex:Loc PP_LatencyReading, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{lex:Loc PP_PollNote}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ================= PERFILES ================= -->
            <!-- PhantomPad: "Perfiles" queda oculto en la barra (se abre desde Juegos > ⋮ > Administrar perfiles) -->
            <TabItem x:Name="profilesTab" Header="{lex:Loc Profiles}" Tag="&#xE77B;" Visibility="Collapsed">
                <DockPanel x:Name="profDockPanel" Margin="22,14,22,8">
                    <ToolBar x:Name="profOptsToolbar" Height="34" DockPanel.Dock="Top" Background="{x:Null}" Margin="0,0,0,8">
                        <Button x:Name="newProfListBtn" Click="NewProfListBtn_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding NewProfile, Source={StaticResource ImgLocPaths}}" />
                                    <TextBlock Text="{lex:Loc New}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="editProfBtn" Margin="10,0,0,0" IsEnabled="False" Click="EditProfBtn_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding EditProfile, Source={StaticResource ImgLocPaths}}" />
                                    <TextBlock Text="{lex:Loc Edit}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="deleteProfBtn" Margin="10,0,0,0" IsEnabled="False" Click="DeleteProfBtn_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding DeleteProfile, Source={StaticResource ImgLocPaths}}" />
                                    <TextBlock Text="{lex:Loc Delete}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="renameProfBtn" Margin="10,0,0,0" IsEnabled="False" Click="RenameProfBtn_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding EditProfile, Source={StaticResource ImgLocPaths}}" />
                                    <TextBlock Text="{lex:Loc RenameProfile}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="dupProfBtn" Margin="10,0,0,0" IsEnabled="False" Click="DupProfBtn_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding DuplicateProfile, Source={StaticResource ImgLocPaths}}" />
                                    <TextBlock Text="{lex:Loc Duplicate}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="importProfBtn" Margin="10,0,0,0" Click="ImportProfBtn_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding ImportProfile, Source={StaticResource ImgLocPaths}}" />
                                    <TextBlock Text="{lex:Loc Import}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="exportProfBtn" Margin="10,0,0,0" IsEnabled="False" Click="ExportProfBtn_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding ExportProfile, Source={StaticResource ImgLocPaths}}" />
                                    <TextBlock Text="{lex:Loc Export}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </ToolBar>
                    <ToolBar x:Name="dupBoxBar" Height="40" DockPanel.Dock="Top" Background="{x:Null}" HorizontalAlignment="Center" Visibility="Collapsed">
                        <local:DupBox x:Name="dupBox" />
                    </ToolBar>

                    <ListBox x:Name="profilesListBox" DockPanel.Dock="Bottom" SelectionChanged="ProfilesListBox_SelectionChanged" MouseDoubleClick="ProfilesListBox_MouseDoubleClick"
                             Background="{DynamicResource SurfaceColor}" Padding="6">
                        <ListBox.Resources>
                            <localConverters:EscapeAccessKeysConverter x:Key="escapeAccessConvert" />
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,5">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentLightColor}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Label Content="{Binding Name, Mode=OneWay, Converter={StaticResource escapeAccessConvert}}" Padding="0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ================= AUTO-PERFILES ================= -->
            <!-- PhantomPad: "Juegos" (une Perfiles y Perfiles automaticos) -->
            <TabItem x:Name="gamesTab" Header="{lex:Loc PP_HubTab}" Tag="&#xE768;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <Grid Margin="22,14,22,8">
                    <!-- PhantomPad: pantalla nueva "Perfiles por juego" -->
                    <gp:GameProfilesControl x:Name="gameProfilesControl" />
                    <!-- Editor avanzado original (mismo archivo de reglas) -->
                    <DockPanel x:Name="advancedAutoProfPanel" Visibility="Collapsed">
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="{lex:Loc PP_GamesBackToGames}" Padding="14,5" Margin="0,0,0,10"
                                Click="BackToGamesBtn_Click" />
                        <local:AutoProfiles x:Name="autoProfControl" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================= SALIDAS ================= -->
            <TabItem Header="{lex:Loc OutputSlots}" Tag="&#xE703;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:OutputSlotManagerControl x:Name="slotManControl" Margin="22,14,22,8" />
            </TabItem>

            <!-- ================= AJUSTES ================= -->
            <TabItem x:Name="settingsTab" Header="{lex:Loc PP_SettingsTab}" Tag="&#xE713;" IsEnabled="{Binding ViewEnabled,Mode=OneWay}">
                <Grid Background="{DynamicResource BackgroundColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- PhantomPad: menu interno de Configuraciones -->
                    <Border Background="{DynamicResource HeaderBarColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10"
                            Margin="22,18,0,14" VerticalAlignment="Top">
                        <ListBox x:Name="settingsNav" Background="Transparent" BorderThickness="0" Margin="0,8" ItemContainerStyle="{StaticResource SubNavItemStyle}"
                                 SelectionChanged="SettingsNav_SelectionChanged">
                            <ListBoxItem Tag="general" IsSelected="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentLightColor}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="{lex:Loc PP_SettingsGeneral}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="commands">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentLightColor}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="{lex:Loc PP_SectionCommands}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="calibration">
                                <StackPanel Orientation="Horizontal">
