                                        <TextBlock Text="&#xE968;" Style="{StaticResource SectionIconStyle}" />
                                        <TextBlock Text="{lex:Loc OscServerHeading, Converter={StaticResource UpperCaseConverter}}" Style="{StaticResource SectionTitleStyle}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="0,6">
                                    <CheckBox x:Name="useOscServerCk" Content="{lex:Loc EnableOscServer}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UseOSCServer}" Click="UseOscServerCk_Click" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding UseOSCServer}">
                                        <Label Content="{lex:Loc Port}" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" />
                                        <xctk:IntegerUpDown d:IsHidden="False" x:Name="oscPortNum" DockPanel.Dock="Right" MinWidth="90"
                                                            Value="{Binding OscPort, UpdateSourceTrigger=LostFocus,FallbackValue='9000'}" ButtonSpinnerLocation="Right" Increment="1" Maximum="65535" Minimum="0" />
                                    </DockPanel>
                                    <CheckBox x:Name="interpretingOscMonitoringCk" Content="{lex:Loc EnableInterpretingOscMonitoring}" Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding InterpretingOscMonitoring}" IsEnabled="{Binding UseOSCServer}" />
                                    <CheckBox x:Name="useOscSenderCk" Content="{lex:Loc EnableOscSender}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UseOSCSender}" Click="UseOscSenderCk_Click" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding UseOSCSender,Mode=OneWay}">
                                        <TextBox x:Name="oscSenderTxt" Text="{Binding OscSenderAddress, UpdateSourceTrigger=LostFocus,FallbackValue='127.0.0.1'}" MinWidth="130" Height="26" VerticalContentAlignment="Center" />
                                        <xctk:IntegerUpDown d:IsHidden="False" x:Name="oscSendPort" DockPanel.Dock="Right" MinWidth="90"
                                                            Value="{Binding OscSendPort, UpdateSourceTrigger=LostFocus,FallbackValue='9000'}" ButtonSpinnerLocation="Right" Increment="1" Maximum="65535" Minimum="0" />
                                        <Label Content="{lex:Loc Port}" DockPanel.Dock="Right" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Width="400">
