                <ScrollViewer x:Name="settingsUpdatesPage" Grid.Column="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <upd:UpdatesControl x:Name="updatesControl" />
                </ScrollViewer>

                <!-- ===== Configuraciones > Inicio ===== -->
                <ScrollViewer x:Name="settingsStartupPage" Grid.Column="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,18,22,8" MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Text="{lex:Loc PP_StartTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{lex:Loc PP_StartIntro}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4,0,16" />

                        <Border Style="{StaticResource SectionCardStyle}" Padding="20,10" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- 1. Iniciar con Windows -->
                                <CheckBox x:Name="runAtStartCk" Content="{lex:Loc PP_StartWithWindows}" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding RunAtStartup}" Click="RunAtStartCk_Click" />
                                <TextBlock Text="{lex:Loc PP_StartWithWindowsText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="16,-4,16,6" />
                                <GroupBox x:Name="runAsGroupBox" Header="{lex:Loc RunAs}" BorderThickness="1" Visibility="{Binding ShowRunStartPanel}" Margin="16,0,16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel>
                                            <RadioButton Content="{lex:Loc Program}" GroupName="RunAsOpt" Margin="4" IsChecked="{Binding RunStartProg}" />
                                            <RadioButton Content="{lex:Loc Task}" GroupName="RunAsOpt" Margin="4" IsChecked="{Binding RunStartTask}" IsEnabled="{Binding CanWriteTask}" />
                                        </StackPanel>
                                        <Image x:Name="uacImg" Source="{Binding UACSource, Mode=OneTime}" Width="30" Height="30" ToolTip="{lex:Loc Resources:UACTask}" Margin="20,0,0,0" />
                                    </StackPanel>
                                </GroupBox>

                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,4" />

                                <!-- 2. Abrir escondido en la bandeja -->
                                <CheckBox Content="{lex:Loc PP_StartHidden}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartHiddenInTray}" />
                                <TextBlock Text="{lex:Loc PP_StartHiddenText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="16,-4,16,6" />

                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,4" />

                                <!-- 3. Al cerrar, dejarlo en la bandeja -->
                                <CheckBox Content="{lex:Loc PP_StartCloseTray}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CloseToTray}" />
                                <TextBlock Text="{lex:Loc PP_StartCloseTrayText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="16,-4,16,6" />

                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,4" />

                                <!-- 4. Conectar los mandos automaticamente -->
                                <CheckBox Content="{lex:Loc PP_StartAutoConnect}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoConnectControllers}" />
                                <TextBlock Text="{lex:Loc PP_StartAutoConnectText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="16,-4,16,6" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{lex:Loc PP_StartTip}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentLightColor}" Margin="4,0,4,8" />
                    </StackPanel>
                </ScrollViewer>

