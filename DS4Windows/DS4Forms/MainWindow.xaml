                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="0,6">
                                    <CheckBox x:Name="customSteamCk" Content="{lex:Loc UseCustomSteamFolder}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UseCustomSteamFolder}" />
