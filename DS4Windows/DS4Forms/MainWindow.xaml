                                        <TextBox x:Name="udpServerTxt" Text="{Binding UdpIpAddress, UpdateSourceTrigger=LostFocus,FallbackValue='127.0.0.1'}" MinWidth="130" Height="26" VerticalContentAlignment="Center" />
