                                </Border>
                                <StackPanel Margin="0,6">
                                    <CheckBox x:Name="useUdpServerCk" Content="{lex:Loc MainWin.EnableServer}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UseUDPServer}" Click="UseUdpServerCk_Click" />
