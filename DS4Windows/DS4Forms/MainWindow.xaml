                                                               Minimum="0.00001" Maximum="100.0" Increment="0.1" MinWidth="90" />
                                        </DockPanel>
                                        <DockPanel>
                                            <Label Content="{lex:Loc MainWin.OneEuroBeta}" Padding="0" VerticalAlignment="Center" />
                                            <xctk:DoubleUpDown d:IsHidden="True" DockPanel.Dock="Right" HorizontalAlignment="Right" FormatString="F5" Value="{Binding UdpSmoothBeta,FallbackValue=0.0,UpdateSourceTrigger=LostFocus}"
                                                               Minimum="0.0" Maximum="1.0" Increment="0.1" MinWidth="90" />
