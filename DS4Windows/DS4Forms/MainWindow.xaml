                                    </DockPanel>
                                    <CheckBox Content="{lex:Loc UseSmoothing}" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UseUdpSmoothing,FallbackValue='False'}" IsEnabled="{Binding UseUDPServer,Mode=OneWay}" />
