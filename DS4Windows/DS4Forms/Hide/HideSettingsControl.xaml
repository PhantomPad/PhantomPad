<UserControl x:Class="DS4WinWPF.DS4Forms.HidePage.HideSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PhantomPad"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <!-- PhantomPad: Configuraciones > Ocultar mandos (HidHide) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhantomPad;component/DS4Forms/Themes/PhantomPadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="16,18,22,8" MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Text="{lex:Loc PP_HideTitle}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{lex:Loc PP_HideIntro}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4,0,16" />

        <!-- HidHide instalado o no -->
        <Border Style="{StaticResource SectionCardStyle}" Padding="20,16" Margin="0,0,0,12">
            <DockPanel>
                <Button x:Name="installBtn" DockPanel.Dock="Right" Content="{lex:Loc PP_HideInstall}" Padding="16,6" VerticalAlignment="Center"
                        Margin="16,0,0,0" Click="InstallBtn_Click" />
                <StackPanel>
                    <TextBlock x:Name="driverTitle" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="driverText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Interruptor -->
        <Border Style="{StaticResource SectionCardStyle}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="hideToggle" Content="{lex:Loc PP_HideToggle}" Style="{StaticResource ToggleSwitchStyle}" Padding="0,6"
                          Checked="HideToggle_Changed" Unchecked="HideToggle_Changed" />
                <TextBlock Text="{lex:Loc PP_HideToggleText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" />
            </StackPanel>
        </Border>

        <!-- Mandos conectados -->
        <Border Style="{StaticResource SectionCardStyle}" Padding="20,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{lex:Loc PP_HideNow}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <StackPanel x:Name="statusList" />
                <TextBlock x:Name="errorText" TextWrapping="Wrap" FontSize="12" Foreground="#F87171" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <TextBlock Text="{lex:Loc PP_HideTip}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentLightColor}" Margin="4,0,4,8" />
    </StackPanel>
</UserControl>
