<UserControl x:Class="DS4WinWPF.DS4Forms.Calibration.StickCalibrationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="PhantomPad"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <!-- PhantomPad: Configuraciones > Calibracion (asistente anti-drift de los sticks) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhantomPad;component/DS4Forms/Themes/PhantomPadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Dibujo de un stick: borde, zona muerta, alcance y punto en vivo -->
            <Style x:Key="StickOuter" TargetType="{x:Type Ellipse}">
                <Setter Property="Width" Value="160" />
                <Setter Property="Height" Value="160" />
                <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="Fill" Value="{DynamicResource TileColor}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="16,18,22,8" MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Text="{lex:Loc PP_CalTitle}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{lex:Loc PP_CalIntro}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4,0,16" />

        <Border Style="{StaticResource SectionCardStyle}" Padding="20,18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: mando, pasos y botones -->
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="{lex:Loc PP_CalController, Converter={StaticResource UpperCaseConverter}}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                    <ComboBox x:Name="controllerCombo" SelectionChanged="ControllerCombo_SelectionChanged" />
                    <TextBlock x:Name="savedText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource AccentLightColor}" />

                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="stepTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="stepText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundColor}" />
                            <ProgressBar x:Name="stepProgress" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                            <TextBlock x:Name="resultText" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="startBtn" Style="{StaticResource OutlineAccentButtonStyle}" Height="34" Padding="18,0" Margin="0,0,10,8"
                                        Click="StartBtn_Click">
                                    <TextBlock Text="{lex:Loc PP_CalStart}" />
                                </Button>
                                <Button x:Name="saveBtn" Style="{StaticResource OutlineAccentButtonStyle}" Height="34" Padding="18,0" Margin="0,0,10,8"
                                        Click="SaveBtn_Click" Visibility="Collapsed">
                                    <TextBlock Text="{lex:Loc PP_CalSave}" />
                                </Button>
                                <Button x:Name="clearBtn" Style="{StaticResource LinkButtonStyle}" Margin="0,0,0,8" Click="ClearBtn_Click" VerticalAlignment="Center">
                                    <TextBlock Text="{lex:Loc PP_CalClear}" Foreground="{DynamicResource AccentLightColor}" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Derecha: los dos sticks en vivo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="{lex:Loc PP_CalLeftStick}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <Canvas Width="160" Height="160">
                            <Ellipse Style="{StaticResource StickOuter}" />
                            <Ellipse x:Name="lsReach" Stroke="{DynamicResource Accent2Color}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.7" />
                            <Ellipse x:Name="lsDead" Fill="{DynamicResource AccentColor}" Stroke="{DynamicResource AccentLightColor}" StrokeThickness="1.5" Opacity="0.75" />
                            <Line X1="80" Y1="10" X2="80" Y2="150" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                            <Line X1="10" Y1="80" X2="150" Y2="80" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                            <Ellipse x:Name="lsDot" Width="10" Height="10" Fill="{DynamicResource Accent2Color}" />
                        </Canvas>
                        <TextBlock x:Name="lsText" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{lex:Loc PP_CalRightStick}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <Canvas Width="160" Height="160">
                            <Ellipse Style="{StaticResource StickOuter}" />
                            <Ellipse x:Name="rsReach" Stroke="{DynamicResource Accent2Color}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.7" />
                            <Ellipse x:Name="rsDead" Fill="{DynamicResource AccentColor}" Stroke="{DynamicResource AccentLightColor}" StrokeThickness="1.5" Opacity="0.75" />
                            <Line X1="80" Y1="10" X2="80" Y2="150" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                            <Line X1="10" Y1="80" X2="150" Y2="80" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                            <Ellipse x:Name="rsDot" Width="10" Height="10" Fill="{DynamicResource Accent2Color}" />
                        </Canvas>
                        <TextBlock x:Name="rsText" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{lex:Loc PP_CalLegend}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}" Margin="4,0,4,8" />
    </StackPanel>
</UserControl>
